<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 17: reaching a computer on the home network (Wi-Fi/Ethernet private addresses). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- THROWAWAY: PB Phase 0 probe B (pb-20261106-08) — the line plan §2a says is missing.
         Delete (together with the probe activity) before any merge. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Make installed speech engines visible on Android 11 and later. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>
        <service
            android:name="dev.patchbay.remote.platform.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
