{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchbay Remote",
  "version": "0.5.0",
  "identifier": "dev.patchbay.remote",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev:remote",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "pnpm --dir .. build:remote",
    "frontendDist": "../../dist-remote"
  },
  "app": {
    "windows": [
      {
        "title": "Patchbay Remote",
        "url": "remote.html",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
