# Builds Patchbay (the desktop app) and patchbayd (headless) from this source checkout:
#   cd packaging/linux/arch && makepkg -si
pkgbase=patchbay
pkgname=(patchbay patchbayd)
pkgver=0.13.0
pkgrel=1
pkgdesc="Desktop LLM client with chat and a coding agent, for any provider"
arch=(x86_64 aarch64)
url="https://github.com/jpsutton/patchbay"
license=(Apache-2.0)
makedepends=(cargo git nodejs pnpm)
options=(!debug !lto)

_srcroot="$(realpath "${startdir}/../../..")"

build() {
  cd "${_srcroot}"
  pnpm install --frozen-lockfile
  pnpm tauri build --no-bundle
  # patchbayd: the same app without Tauri, serving the UI pnpm built above.
  (cd src-tauri && cargo build --release --locked --bin patchbayd --no-default-features --features web)
}

_notices() {
  local licenses="${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 LICENSE NOTICE THIRD_PARTY_NOTICES.md -t "${licenses}"
}

package_patchbay() {
  depends=(webkit2gtk-4.1 gtk3 libayatana-appindicator dbus xdotool hicolor-icon-theme)
  cd "${_srcroot}"
  install -Dm755 src-tauri/target/release/patchbay "${pkgdir}/usr/lib/patchbay/patchbay"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /usr/lib/patchbay/patchbay "${pkgdir}/usr/bin/patchbay"

  install -Dm644 packaging/linux/patchbay.desktop "${pkgdir}/usr/share/applications/patchbay.desktop"
  local size
  for size in 32 64 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/patchbay.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/patchbay.png"

  _notices
}

package_patchbayd() {
  pkgdesc="Patchbay, headless: chats, Code sessions and the mesh, with a browser UI"
  depends=(dbus glibc)
  cd "${_srcroot}"
  # The UI, found next to its executable.
  install -Dm755 src-tauri/target/release/patchbayd "${pkgdir}/usr/lib/patchbayd/patchbayd"
  cp -r dist "${pkgdir}/usr/lib/patchbayd/web"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /usr/lib/patchbayd/patchbayd "${pkgdir}/usr/bin/patchbayd"
  install -Dm644 packaging/linux/daemon/patchbayd.service "${pkgdir}/usr/lib/systemd/user/patchbayd.service"
  install -Dm644 packaging/linux/daemon/patchbayd@.service "${pkgdir}/usr/lib/systemd/system/patchbayd@.service"
  install -Dm644 docs/headless.md "${pkgdir}/usr/share/doc/patchbayd/README.md"
  _notices
}
