{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchbay",
  "version": "0.1.0",
  "identifier": "dev.patchbay.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patchbay",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 500,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/grok"],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../vendor/grok-build/THIRD-PARTY-NOTICES": "GROK_BUILD_THIRD_PARTY_NOTICES",
      "../vendor/grok-build/third_party/NOTICE": "GROK_BUILD_VENDORED_NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
