+++ b/crates/build/xai-proto-build/src/lib.rs
@@ -150,6 +150,18 @@ impl XaiProtoBuilder {
             );
         }
 
+        // Windows has no /dev/stdout or /dev/null for protoc to write to: watch the protos and
+        // include directories instead of asking protoc for the exact dependency list.
+        if cfg!(windows) {
+            for path in protos.into_iter().chain(includes) {
+                println!(
+                    "cargo:rerun-if-changed={}",
+                    path.to_str().context("path not UTF-8")?
+                );
+            }
+            return Ok(());
+        }
+
         // Can only process one input file when using --dependency_out=FILE.
